<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Online/offline detection: resync calendars on reconnect, offline icon (SPEC §13). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi name and signal in Settings → System (read-only). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- FrameMedia/, removable volumes (read-only), dev UI folder; granted at install with adb install -g. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Sleep and wake (SPEC §18): wake the screen at the wake-up time, keep the CPU up while asleep. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bring OpenFrame to the front after boot when it is the home app (SPEC §18). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Brightness through Android's setting, like Frameo; granted with adb after the user's OK (SPEC §18). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- "Back to OpenFrame" button over Android screens; granted with adb after the user's OK (SPEC §19). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Free the Android Settings screen's memory after returning from it (SPEC §19). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- USB debugging switch in Settings → System, like Frameo (only ADB_ENABLED is written); granted
         with adb after the user's OK: adb shell pm grant app.openframe android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".OpenFrameApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          HOME entry (SPEC §18), off by default: an enabled HOME filter changes Android's set of home
          apps, which drops Frameo's "always" choice and shows a chooser on a frame with no navigation.
          Switched on from a computer with the user's approval (see HomeApp.kt):
            adb shell pm enable app.openframe/.HomeActivity
            adb shell cmd package set-home-activity app.openframe/.HomeActivity
        -->
        <activity-alias
            android:name=".HomeActivity"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Sleep (SPEC §18): lockNow() only. Activated from a computer with the user's approval:
             adb shell dpm set-active-admin app.openframe/.SleepAdminReceiver -->
        <receiver
            android:name=".SleepAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Keeps the process in the foreground class while the UI exists, so the night wake lock holds (SPEC §18). -->
        <service android:name=".FrameService" android:exported="false" />

        <receiver android:name=".PowerAlarmReceiver" android:exported="false" />
        <receiver android:name=".RestartReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
